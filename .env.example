# =============================================================================
# The Principals Club · Environment
# Copy this file to .env.local and fill in what you have. Without Supabase the
# app runs as the furnished example (the tour), which is complete in itself.
# =============================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The furnished example ("Tour the House"). Set to "false" to hide it once the
# Club is connected to real records and you no longer want a public demo.
NEXT_PUBLIC_ENABLE_PREVIEW=

# ---- Supabase (auth, database, realtime) ----
NEXT_PUBLIC_SUPABASE_URL=
# Either the newer publishable key or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Monday check-in reminder (Supabase Edge Function) ----
RESEND_API_KEY=
